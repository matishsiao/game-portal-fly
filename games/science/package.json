{
  "name": "offline-science",
  "version": "1.0.0",
  "private": true,
  "description": "可離線遊玩的單機自然探險（Science Explorer）PWA",
  "type": "module",
  "engines": {
    "node": ">=16.17"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:https": "node scripts/serve.mjs --https",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs --dist",
    "preview:https": "node scripts/build.mjs && node scripts/serve.mjs --dist --https",
    "test": "node --test tests/",
    "check:puzzles": "node scripts/check-bank.mjs",
    "check:release": "node scripts/check-bank.mjs --strict",
    "icons": "node scripts/make-icons.mjs"
  }
}
