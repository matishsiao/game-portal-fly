{
  "name": "offline-pocketdungeon",
  "version": "1.0.0",
  "private": true,
  "description": "可離線遊玩的單機口袋地城（復古像素俯視角動作 RPG）PWA",
  "type": "module",
  "engines": {
    "node": ">=16.17"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "dev:https": "node scripts/serve.mjs --https",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/build.mjs && node scripts/serve.mjs --dist",
    "preview:https": "node scripts/build.mjs && node scripts/serve.mjs --dist --https",
    "test": "node --test tests/",
    "check:dungeons": "node scripts/check-dungeons.mjs",
    "check:balance": "node scripts/check-balance.mjs",
    "icons": "node scripts/make-icons.mjs"
  }
}
